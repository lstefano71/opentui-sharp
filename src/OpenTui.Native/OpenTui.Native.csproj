<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OpenTui</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <NativeDllSource>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', 'node_modules', '@opentui', 'core-win32-x64', 'opentui.dll'))</NativeDllSource>
    <NativeDllTarget>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', 'runtimes', 'win-x64', 'native', 'opentui.dll'))</NativeDllTarget>
  </PropertyGroup>

  <!-- Copy the native DLL from npm to the NuGet runtimes convention path -->
  <Target Name="CopyNativeDll" BeforeTargets="Build" Condition="Exists('$(NativeDllSource)')">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(NativeDllTarget)'))" />
    <Copy SourceFiles="$(NativeDllSource)" DestinationFiles="$(NativeDllTarget)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenTui" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\runtimes\win-x64\native\opentui.dll" Pack="true" PackagePath="runtimes\win-x64\native\"
          Condition="Exists('..\..\runtimes\win-x64\native\opentui.dll')">
      <Link>runtimes\win-x64\native\opentui.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
